  platform          String    // instagram|facebook|tiktok
  external_post_id  String?
  post_url          String?
  content_hash      String?   // sha256 of normalized caption+posted_at(day) — dedup fallback when external_post_id/post_url are null or drift between scrapes
  caption           String?
  media_url         String?
  video_url         String?   // raw video file, when the post is a video — separate from media_url (thumbnail)
  posted_at         DateTime?
  likes             Int?
  comments_count    Int?
  first_seen_at     DateTime  @default(now())
  last_seen_at      DateTime  @default(now())
  analysis          String?   // JSON: {topic, has_offer, offer_details, offer_mechanic, offer_value_framing, offer_urgency, offer_conditions, offer_redemption, offer_in_image, offer_audience_intent, visual_hooks, text_hooks, style, has_cta, cta, video_description, video_script} — offer_* fields populated only when has_offer=true; video_* only when analyzed via video_url
  analyzed_at       DateTime?
  video_analyzed_at DateTime? // set once the video (not just the thumbnail) has been analyzed — never re-analyzed via video after this
  has_offer         Boolean?  // null = not yet analyzed
  has_cta           Boolean?

  @@index([linked_business, competitor_id, posted_at])
  @@unique([competitor_id, platform, external_post_id])
  @@unique([competitor_id, platform, content_hash])
  @@map("competitor_posts")
}

