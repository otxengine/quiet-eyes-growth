generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BusinessProfile {
  id                         String   @id @default(cuid())
  created_date               DateTime @default(now())
  created_by                 String?
  name                       String
  category                   String
  city                       String
  full_address               String?
  tone_preference            String?  @default("friendly")
  target_market              String?
  description                String?
  min_budget                 String?
  relevant_services          String?
  preferred_area             String?
  weekly_report              Boolean? @default(true)
  hot_lead_alerts            Boolean? @default(true)
  monthly_summary            Boolean? @default(false)
  push_email_alerts          Boolean? @default(false)
  push_whatsapp_alerts       Boolean? @default(false)
  push_whatsapp_number       String?
  push_min_score             Float?   @default(80)
  bot_enabled                Boolean? @default(false)
  bot_greeting               String?
  bot_qualification_questions String?
  bot_good_lead_criteria     String?
  bot_bad_lead_criteria      String?
  bot_services_info          String?
  bot_working_hours_start    String?
  bot_working_hours_end      String?
  bot_off_hours_message      String?
  channels_whatsapp          String?
  channels_whatsapp_enabled  Boolean? @default(false)
  channels_instagram         String?
  channels_instagram_enabled Boolean? @default(false)
  channels_facebook          String?
  channels_facebook_enabled  Boolean? @default(false)
  channels_tiktok            String?
  channels_tiktok_enabled    Boolean? @default(false)
  channels_website           String?
  channels_website_enabled   Boolean? @default(false)
  channels_webhook_secret    String?
  website_url                String?
  facebook_url               String?
  instagram_url              String?
  tiktok_url                 String?
  custom_keywords            String?
  custom_urls                String?
  monitor_competitors_social Boolean? @default(true)
  onboarding_completed       Boolean? @default(false)
  plan_id                    String?  @default("free")
  subscription_plan          String?
  subscription_status        String?  @default("none")
  stripe_customer_id         String?
  subscription_started_at    String?
  auto_respond_enabled       Boolean? @default(false)
  auto_respond_min_rating    Float?   @default(5)
  auto_respond_notify        Boolean? @default(true)
  wa_alert_phone             String?
  wa_alert_negative_review   Boolean? @default(true)
  wa_alert_hot_lead          Boolean? @default(true)
  wa_alert_high_impact       Boolean? @default(false)
  crm_webhook_url            String?
  crm_webhook_enabled        Boolean? @default(false)
  crm_sync_events            String?  @default("create,update")
  crm_zapier_url             String?
  crm_zapier_enabled         Boolean? @default(false)
  crm_last_sync              String?
  crm_sync_count             Float?   @default(0)
  crm_hubspot_api_key        String?
  crm_hubspot_enabled        Boolean? @default(false)
  crm_hubspot_pipeline_id    String?
  crm_hubspot_field_map      String?
  crm_monday_api_key         String?
  crm_monday_enabled         Boolean? @default(false)
  crm_monday_board_id        String?
  crm_monday_field_map       String?
  survey_enabled             Boolean? @default(false)
  survey_q1                  String?
  survey_q2                  String?
  survey_q3                  String?
  locations_prompt_dismissed Boolean? @default(false)
  created_at                 String?
  google_place_id            String?
  google_place_id_verified   Boolean? @default(false)
  google_rating              Float?
  google_review_count        Float?
  // Autonomy + API execution
  autonomy_level             String?  @default("semi_auto") // 'manual' | 'semi_auto' | 'full_auto'
  whatsapp_phone_number_id   String?  // Meta WhatsApp Cloud API phone number ID
  whatsapp_access_token      String?  // encrypted Meta system user token
  google_access_token        String?  // Google Business Profile OAuth token
  instagram_access_token     String?  // Instagram Graph API token
  instagram_page_id          String?  // Instagram Business account ID
  facebook_page_token        String?  // Facebook Page access token
  facebook_page_id           String?  // Facebook Page ID
  owner_name                 String?  // Contact person / business owner full name
  phone                      String?  // Business contact phone number
  search_radius_km           Int?     @default(15)
  additional_cities          String?
  branches                   String?  // JSON array of branch objects
  lead_intent_signals        String?  // Free-text: phrases indicating purchase intent
  lead_quality_notes         String?  // Free-text: what makes a lead high-quality for this business
  // Onboarding intelligence
  business_goal              String?  // 'new_customers' | 'retain' | 'more_per_customer' | 'reviews'
  price_tier                 String?  // 'budget' | 'mid' | 'premium'
  customer_sources           String?  // JSON array: ['google', 'instagram', 'word_of_mouth', ...]
  sector_profile             String?  // JSON: AI-parsed sub-sector context for agents
  agent_missions             String?  // JSON: LLM-generated per-agent mission plan (generated once at onboarding)
  // §5.0 identity draft (KAN-196)
  about_draft                String?  // JSON: 9-key identity draft pending owner approval
  about_status               String?  @default("pending") // 'pending' | 'approved' | 'rejected'
  // §5.2 identity persistence (KAN-197)
  about_approved              String?  // JSON: approved 9-key identity (canonical; written only on Approve)
  about_sources               String?  // JSON array: source types used for the last generate/regenerate
  about_source_excerpts       String?  // JSON: {source_type: {url?, excerpt}} raw provenance (KAN-202)
  about_generated_at          String?  // ISO timestamp of last generate/regenerate
  about_approved_at           String?  // ISO timestamp of last Approve
  // Synthesized explanation of the common pattern(s) across this business's
  // own current outlier/top-performing posts.
  outlier_insight              String?  // 2-4 sentences (Hebrew)
  outlier_insight_at           String?  // ISO timestamp
  // Synthesized explanation of the pattern(s) recurring across the top posts
  // pooled from ALL of this business's tracked competitors (not one competitor),
  // split into copy (caption/CTA/text hooks) vs visual (creative/style/visual hooks).
  content_trends_copy_insight    String?  // 2-4 sentences (Hebrew)
  content_trends_copy_examples   String?  // JSON array of {competitorName, text} — real verbatim quotes exemplifying content_trends_copy_insight
  content_trends_visual_insight  String?  // 2-4 sentences (Hebrew)
  content_trends_insight_at      String?  // ISO timestamp
  // Synthesized explanation of what competitors' social bios commonly contain
  // and how they're structured, pooled from ALL tracked competitors' profiles.
  content_trends_bio_insight     String?  // 3-5 sentences (Hebrew)
  content_trends_bio_examples    String?  // JSON array of {competitorName, text} — real verbatim bios exemplifying content_trends_bio_insight
  content_trends_bio_insight_at  String?  // ISO timestamp
  // Synthesized visual pattern across tracked competitors' logos/profile
  // pictures (style, colors, professional-quality markers) — text-only,
  // built from a per-competitor vision description, not the raw images.
  content_trends_logo_insight     String?  // 2-4 sentences (Hebrew)
  content_trends_logo_insight_at  String?  // ISO timestamp

  @@map("business_profiles")
}

model Lead {
  id                  String   @id @default(cuid())
  created_date        DateTime @default(now())
  created_by          String?
  linked_business     String?
  linked_location     String?
  name                String
  source              String?
  score               Float?
  status              String?
  budget_range        String?
  service_needed      String?
  contact_info        String?
  contact_phone       String?
  questionnaire_answers String?
  city                String?
  urgency             String?
  intent_source       String?
  intent_strength     String?
  created_at          String?
  lifecycle_stage     String?  @default("new")
  lifecycle_updated_at String?
  notes               String?
  next_action         String?
  next_action_date    String?
  total_value         Float?
  tags                String?
  source_url          String?
  source_description  String?
  discovery_method    String?
  closed_value        Float?
  closed_at           String?
  source_agent        String?
  source_origin       String?  @default("manual")
  // P1: Intent Freshness Score
  discovered_at       String?
  freshness_score     Float?   @default(100)
  last_contact_at     String?
  next_followup_date  String?
  followup_count      Float?   @default(0)
  referral_source     String?
  score_reasoning     String?
  suggested_first_message String?
  // ROI tracking
  deal_value              Float?   // actual deal value when closed_won (₪)
  platform_sourced        Boolean? @default(false) // was this lead found by platform agents?

  @@map("leads")
}

model Review {
  id               String   @id @default(cuid())
  created_date     DateTime @default(now())
  created_by       String?
  linked_business  String?
  linked_competitor String?  // KAN-121: set for competitor reviews; null for own-business reviews
  linked_location  String?
  platform         String?
  rating           Float?
  text             String
  reviewer_name    String?
  sentiment        String?
  suggested_response String?
  response_status  String?  @default("pending")
  source_url       String?
  created_at       String?
  source_origin    String?  @default("manual")
  google_review_id String?
  is_verified      Boolean? @default(false)
  // P1: Sentiment Topic Extraction
  topics           String?  // comma-separated topic list
  topic_sentiment  String?  // JSON: { topic: sentiment }

  @@map("reviews")
}

model Competitor {
  id                   String   @id @default(cuid())
  created_date         DateTime @default(now())
  created_by           String?
  linked_business      String?
  linked_location      String?
  name                 String
  category             String?
  rating               Float?
  review_count         Float?
  trend_direction      String?
  strengths            String?
  weaknesses           String?
  services             String?
  price_range          String?
  last_known_prices    String?
  last_price_check     String?
  price_changed_at     String?
  address              String?
  tags                 String?
  notes                String?
  last_scanned         String?
  battlecard_headline  String?
  battlecard_content   String?
  battlecard_updated_at String?
  source_urls          String?
  data_freshness       String?
  verification_status  String?  @default("לא מאומתת")
  menu_highlights      String?
  price_points         String?
  current_promotions   String?
  opening_hours        String?
  recent_reviews_summary String?
  is_dismissed         Boolean? @default(false)
  tracking_status      String?  @default("pending_review") // 'pending_review' | 'approved' | 'rejected' — onboarding review gate for deep research
  // ── Social page discovery & monitoring ──────────────────────────────────
  website_url              String?  // competitor website (populated by identification agent)
  instagram_url            String?  // discovered from website or Tavily
  facebook_url             String?  // discovered from website or Tavily
  tiktok_url               String?  // discovered from website or Tavily
  social_pages_crawled_at  String?  // last time we crawled the website for social links
  manual_url_fields        String[] @default([])  // KAN-222: which of website/instagram/facebook/tiktok url the owner set by hand — protected from high-confidence auto overwrite unless force
  website_url_source       String?  // KAN-224: 'places'|'serp'|'tavily' — which fallback filled website_url
  instagram_url_source     String?  // KAN-224: 'site_extract'|'serp'|'tavily'
  facebook_url_source      String?  // KAN-224: 'site_extract'|'serp'|'tavily'
  tiktok_url_source        String?  // KAN-224: 'site_extract'|'serp'|'tavily'
  strongest_channel        String?  // 'instagram'|'facebook'|'tiktok'|'google'|'unknown'
  social_post_frequency    String?  // e.g. '3 פוסטים בשבוע'
  social_followers_est     String?  // estimated follower range e.g. '1k-5k'
  engagement_level         String?  // 'low'|'medium'|'high'
  content_themes           String?  // comma-separated topics they post about
  sentiment_from_reviews   String?  // 'positive'|'negative'|'mixed'|'unknown'
  // ── Live monitoring results ──────────────────────────────────────────────
  last_promo_detected      String?  // latest promotion text found
  last_promo_detected_at   String?  // ISO timestamp
  last_product_detected    String?  // new product/service text
  last_product_detected_at String?  // ISO timestamp
  sponsored_ads_detected   Boolean? @default(false)  // are they running paid ads?
  sponsored_ads_updated_at String?
  active_ad_platforms      String?  // comma-separated: 'facebook, instagram, tiktok, google'
  active_ad_count          Int?     @default(0)
  active_ads_summary       String?  // JSON: [{platform, title, body, cta, start}]
  // ── Deep Claude analysis of ad campaigns ─────────────────────────────────
  ad_target_audience       String?  // who they're targeting based on ad copy
  ad_strategy_summary      String?  // their overall ad strategy (1-2 sentences)
  ad_spend_signal          String?  // 'low'|'medium'|'high' — based on platform count + ad count
  ad_gaps                  String?  // what they're NOT advertising = our opportunity
  ad_intel_updated_at      String?  // when Claude last analyzed their ads
  // ── Deep social content analysis (grounded in per-post analysis JSON) ───
  social_deep_analysis     String?  // JSON: {visual_identity, content_pillars, hook_patterns, cta_strategy, promotion_pattern, caption_patterns, ad_messaging, offer_recommendation, top_content_insight, our_opportunity, offer_stats}. offer_stats (computed, not LLM): {total_offers, peak_day, peak_day_count, avg_interval_days, mechanic_breakdown, value_framing_breakdown, audience_intent_breakdown, redemption_breakdown, urgency_pct, conditions_pct, in_image_pct, performance: {avg_likes_offer_posts, avg_likes_regular_posts, avg_comments_offer_posts, avg_comments_regular_posts}}
  social_deep_analysis_at  String?  // ISO timestamp
  // Synthesized explanation of the common pattern(s) across this competitor's
  // current outlier/top-performing posts — separate from social_deep_analysis
  // above, which summarizes ALL recent posts, not just the outliers.
  outlier_insight          String?  // 2-4 sentences (Hebrew)
  outlier_insight_at       String?  // ISO timestamp
  not_relevant             Boolean? @default(false)
  not_relevant_reason      String?
  google_place_id          String?  // KAN-121: place_id used for review ingest
  discovery_sources        String?  // KAN-216: JSON array — which APIs surfaced this row ('google_places'|'dataforseo_maps')
  posts                    CompetitorPost[]
  ad_history               CompetitorAdHistory[]
  stories                  CompetitorStory[]
  social_profiles          CompetitorSocialProfile[]

  @@map("competitors")
}

