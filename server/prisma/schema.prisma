  cover_photo_url     String?
  bio                 String?
  external_url        String?
  follower_count      Int?
  following_count     Int?
  post_count          Int?
  is_verified         Boolean?
  is_business_account Boolean?
  category            String?
  contact_phone       String?
  contact_email       String?
  contact_address     String?
  highlight_count     Int?
  highlights          String?   // JSON array of {title, cover_url} — best-effort, actor may not return actual highlight content beyond the count
  checkin_count       Int?      // Facebook "were here" count — null for Instagram/TikTok
  last_post_at        DateTime? // Facebook last-post date — null for Instagram/TikTok
  raw_data            String?   // JSON: full unprocessed Apify dataset item, so nothing is lost regardless of scalar field mapping
  fetched_at          DateTime  @default(now())
  // AI-suggested rewrite of this platform's bio, grounded in the winning-bio
  // pattern synthesized across tracked competitors (BusinessProfile.content_trends_bio_insight).
  suggested_bio           String?  // proposed rewritten bio (Hebrew)
  suggested_bio_rationale String?  // 1-3 sentences: what changed and why (Hebrew)
  suggested_bio_at        String?  // ISO timestamp
  // AI vision critique of this platform's profile picture/logo, grounded in
  // the visual pattern synthesized across tracked competitors' logos
  // (BusinessProfile.content_trends_logo_insight).
  logo_critique       String?  // 2-4 sentences (Hebrew) with concrete suggestions
  logo_critique_at    String?  // ISO timestamp
  logo_needs_redesign Boolean? // set alongside logo_critique — gates the "generate a new logo" CTA
  // AI-generated candidate replacement logo (own S3, permanent URL), grounded
  // in logo_critique + the competitor visual pattern — a first-draft concept,
  // not auto-applied anywhere (no platform API exists to push a profile picture live).
  suggested_logo_url  String?
  suggested_logo_at   String?  // ISO timestamp

  @@unique([linked_business, platform])
  @@map("business_social_profiles")
}

