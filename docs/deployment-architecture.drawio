        <mxCell id="t-api" value="&lt;b&gt;ECS Fargate · api&lt;/b&gt;&lt;br&gt;2 tasks (AZ-a, AZ-b) · arm64&lt;br&gt;0.5 vCPU / 1 GB · autoscale 2→4&lt;br&gt;/healthz · auto-rollback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="t-vpc">
