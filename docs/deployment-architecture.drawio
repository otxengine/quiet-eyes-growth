        <mxCell id="t-vpc" value="VPC · 2 AZs · tasks in public subnets (inbound from ALB only) · RDS in isolated subnets" style="swimlane;startSize=30;html=1;align=left;spacingLeft=10;fontSize=11;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f7fbff;" vertex="1" parent="t-region">
